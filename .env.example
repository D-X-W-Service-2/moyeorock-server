DB_ROOT_PASSWORD=your-root-password
DB_USERNAME=moyeorock
DB_PASSWORD=your-password

# openssl rand -base64 64 로 생성
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ISSUER=moyeorock
JWT_ACCESS_TOKEN_EXPIRY=1209600000

# 카카오 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키 REST API 키). 시크릿은 선택(카카오 콘솔에서 켰을 때만)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/login/oauth2/code/kakao

# 파일 업로드 — 비워두면 로컬 디스크 저장이 기본값(AWS 비용 없음).
# S3로 전환할 땐 FILE_STORAGE_TYPE=s3로 바꾸고 file.storage.s3.bucket/region/upload-url-expiry-seconds를
# application.yml에 추가한다(upload-url-expiry-seconds를 빠뜨리면 발급한 URL이 바로 만료된다).
FILE_STORAGE_TYPE=local
FILE_LOCAL_BASE_PATH=./uploads
FILE_LOCAL_BASE_URL=http://localhost:8080

# Swagger 문서(/swagger-ui.html, /v3/api-docs) — 값이 없으면 닫힌다(운영 기본). 로컬·개발에서만 true로 켠다.
SWAGGER_ENABLED=true

# CORS 허용 origin(쉼표 구분). 비워두면 application.yml 기본값(localhost + 프론트 시험·점검용 배포 주소)을 쓴다.
# 운영 배포에서는 운영 프론트 주소로 목록 전체를 지정한다.
# CORS_ALLOWED_ORIGINS=https://moyeorock.kro.kr
