# MySQL root 계정 비밀번호 — docker-compose의 MYSQL_ROOT_PASSWORD 및 healthcheck 인증에 사용
DB_ROOT_PASSWORD=

# 앱용 MySQL 계정 이름 — docker-compose의 MYSQL_USER, application.yml의 datasource username에 사용
DB_USERNAME=

# 앱용 MySQL 계정 비밀번호 — docker-compose의 MYSQL_PASSWORD, application.yml의 datasource password에 사용
DB_PASSWORD=
